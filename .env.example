# Google PageSpeed Insights API key (free). Works without it but with a much lower quota.
PSI_API_KEY=

# Anthropic API key for the AI UX/CRO audit. Without it, rule-based UX checks are used.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5

# Where "Get full audit" requests go (n8n / Make / Zapier / Google Apps Script webhook).
LEAD_WEBHOOK_URL=

# Scans allowed per IP per hour, and how many UX issues the free report shows.
SCANS_PER_HOUR=15
FREE_UX_ISSUES=3

# Testing only: fake Google PSI data (no API call)
MOCK_PSI=0
